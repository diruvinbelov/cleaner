# Скопируйте в .env (локально) или внесите в Coolify -> Environment Variables.
# Никогда не коммитьте .env в git!

# Ключ подписи сессий (любая длинная случайная строка: openssl rand -hex 32)
SECRET_KEY=
# true, когда приложение открыто по HTTPS
COOKIE_SECURE=false

# --- GLPI ---
GLPI_URL=https://glpi.narvahaigla.ee/apirest.php
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
# false, если у GLPI самоподписанный сертификат
GLPI_VERIFY_TLS=false
GLPI_NAME_PREFIX=WS
GLPI_STATE_NAME=В работе

# --- Вход через AD ---
LDAP_SERVER=ldaps://svds1.narvahaigla.ee
LDAP_DOMAIN=narvahaigla.ee
LDAP_VERIFY_TLS=false
# Если LDAPS (636) не настроен: LDAP_SERVER=ldap://svds1.narvahaigla.ee и LDAP_START_TLS=true
LDAP_START_TLS=false
# Кому разрешён вход: список логинов через запятую и/или группа AD
LDAP_ALLOWED_USERS=abelyaev
LDAP_ALLOWED_GROUP=

# --- Компьютеры ---
SSH_PORT=22
CHECK_TIMEOUT=2
INVENTORY_WARN_DAYS=14
